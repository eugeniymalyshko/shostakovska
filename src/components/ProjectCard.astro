---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, category, cover, coverAlt, background } = project.data;
---

<a class="project-card" href={`/work/${project.id}/`}>
	<div class:list={['project-image', `bg-${background}`]}>
		<Image src={cover} alt={coverAlt} widths={[640, 960, 1400]} sizes="(max-width: 760px) 100vw, 50vw" />
	</div>
	<div class="project-info">
		<h3>{title}</h3>
		<p>{category}</p>
	</div>
</a>

<style lang="scss">
	@use '../styles/variables' as *;
	@use '../styles/mixins' as *;

	.project-card {
		display: grid;
		grid-template-rows: minmax(25rem, 1fr) auto;
		min-width: 0;
		border-bottom: $line;

		&:nth-child(odd) {
			border-right: $line;
		}

		// A lone last card spans the full row
		&:last-child:nth-child(odd) {
			grid-column: 1 / -1;
			border-right: 0;

			.project-image {
				min-height: 38rem;
			}
		}

		&:hover {
			.project-image img {
				transform: scale(1.025) rotate(-0.3deg);
			}

			.project-image::after {
				transform: translateY(0);
			}
		}

		@include mobile {
			grid-template-rows: minmax(22rem, 1fr) auto;

			&,
			&:nth-child(odd) {
				border-right: 0;
			}

			&:last-child:nth-child(odd) {
				grid-column: auto;

				.project-image {
					min-height: 0;
				}
			}
		}
	}

	.project-image {
		position: relative;
		display: grid;
		place-items: center;
		overflow: hidden;
		padding: clamp(1rem, 3vw, 3.5rem);
		background: #ddd;
		isolation: isolate;

		img {
			width: 100%;
			height: 100%;
			max-height: 34rem;
			object-fit: contain;
			filter: drop-shadow(0 1rem 1.3rem #0002);
			transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
		}

		&::after {
			content: 'View project ↗';
			position: absolute;
			right: $gutter;
			bottom: $gutter;
			padding: 0.45rem 0.65rem;
			background: $ink;
			color: $white;
			@include label(0.75rem);
			transform: translateY(4rem);
			transition: transform 0.25s ease;

			@include mobile {
				transform: none;
			}
		}

		@include reduced-motion {
			img,
			&::after {
				transition: none;
			}
		}
	}

	.bg-blue { background: $blue; }
	.bg-yellow { background: $yellow; }
	.bg-red { background: $red; }
	.bg-grey { background: $grey; }
	.bg-black { background: $black; }

	.project-info {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: $gutter;
		padding: $gutter;
		border-top: $line;
		background: $paper;

		h3,
		p {
			margin: 0;
		}

		h3 {
			font-size: 1.25rem;
			text-transform: uppercase;
			letter-spacing: -0.025em;
		}

		p {
			font-size: 0.78rem;
			text-align: right;
			text-transform: uppercase;
		}
	}
</style>
