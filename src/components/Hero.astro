---
const year = new Date().getFullYear();
---

<section class="intro" aria-labelledby="intro-title">
	<h1 class="hero-name" id="intro-title">
		<span>Ksusha</span>
		<span>Shostakovska</span>
	</h1>
	<div class="hero-meta">
		<div>Graphic designer<br />&amp; visual artist</div>
		<div>Typography · Publications<br />Illustration · Objects</div>
		<div>Antwerp, Belgium<br />{year}</div>
	</div>
</section>

<style lang="scss">
	@use '../styles/variables' as *;
	@use '../styles/mixins' as *;

	.intro {
		min-height: calc(100svh - #{$header-height});
		display: grid;
		grid-template-rows: 1fr auto;
		border-bottom: $line;
		overflow: hidden;

		@include mobile {
			min-height: 84svh;
		}
	}

	.hero-name {
		align-self: center;
		margin: 0;
		padding: 2vw $gutter;
		font-size: clamp(4.3rem, 11vw, 13rem);
		line-height: 0.73;
		letter-spacing: -0.095em;
		text-transform: uppercase;
		font-weight: 900;

		span {
			display: block;
			margin-bottom: 8px;

			&:last-child {
				color: $blue;
			}
		}

		@include mobile {
			font-size: 3rem;
		}
	}
	@media (min-width: 768px) {
		.hero-name{
			span {
				&:last-child {
					margin-left: 8vw;
				}
			}
		}

	}

	.hero-meta {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: $line;
		@include label(0.85rem);

		div {
			padding: 0.8rem $gutter;
			border-right: $line;

			&:last-child {
				border-right: 0;
				text-align: right;
			}
		}

		@include mobile {
			grid-template-columns: 1fr;

			div {
				border-right: 0;
				border-bottom: $line;

				&:last-child {
					border-bottom: 0;
					text-align: left;
				}
			}
		}
	}
</style>
