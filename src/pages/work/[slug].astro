---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/projects';

export const getStaticPaths = (async () => {
	const projects = await getProjects();

	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: {
			project,
			// Wrap around so the last project links back to the first
			previous: projects[(i - 1 + projects.length) % projects.length],
			next: projects[(i + 1) % projects.length],
		},
	}));
}) satisfies GetStaticPaths;

const { project, previous, next } = Astro.props;
const { title, type, description, images } = project.data;
---

<BaseLayout title={title} description={description}>
	<main>
		<section class="case-header">
			<div class="back-row"><a class="text-link" href="/#work">← All work</a></div>
			<h1 class="case-title">{title}</h1>
			<div class="case-meta">
				<p class="type">{type}</p>
				<p class="description">{description}</p>
			</div>
		</section>

		<section class="case-gallery" aria-label="Project images">
			{
				images.map((image, i) => (
					<figure class:list={['case-shot', { wide: i === 0 }]}>
						<Image
							src={image}
							alt={`${title}, selected page ${i + 1}`}
							widths={[640, 960, 1400, 2000]}
							sizes={i === 0 ? '100vw' : '(max-width: 760px) 100vw, 50vw'}
							loading={i > 1 ? 'lazy' : 'eager'}
						/>
					</figure>
				))
			}
		</section>

		<nav class="case-nav" aria-label="Project navigation">
			<a href={`/work/${previous.id}/`}>← {previous.data.title}</a>
			<a href={`/work/${next.id}/`}>{next.data.title} →</a>
		</nav>
	</main>
</BaseLayout>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/mixins' as *;

	.case-header {
		min-height: 74svh;
		display: grid;
		grid-template-rows: auto 1fr auto;
		border-bottom: $line;

		@include mobile {
			min-height: 66svh;
		}
	}

	.back-row {
		padding: $gutter;
		border-bottom: $line;
		font-weight: 700;
		text-transform: uppercase;
	}

	.case-title {
		align-self: center;
		margin: 0;
		padding: 3rem $gutter;
		font-size: clamp(4rem, 12vw, 11rem);
		line-height: 0.78;
		letter-spacing: -0.08em;
		text-transform: uppercase;
		overflow-wrap: anywhere;
	}

	.case-meta {
		display: grid;
		grid-template-columns: 1fr 2fr;
		border-top: $line;

		> * {
			margin: 0;
			padding: $gutter;
		}

		.type {
			border-right: $line;
			@include label;
		}

		.description {
			max-width: 36ch;
			font-size: clamp(1.25rem, 2.5vw, 2.2rem);
			line-height: 1.08;
			letter-spacing: -0.035em;
		}

		@include mobile {
			grid-template-columns: 1fr;

			.type {
				border-right: 0;
				border-bottom: $line;
			}
		}
	}

	.case-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		background: #deddd8;

		@include mobile {
			grid-template-columns: 1fr;
		}
	}

	.case-shot {
		min-height: 35rem;
		margin: 0;
		padding: clamp(1rem, 3vw, 3rem);
		display: grid;
		place-items: center;
		border-right: $line;
		border-bottom: $line;

		// The first image is wide, so the pairs after it start on an even index
		&:nth-child(even) {
			border-right: 0;
		}

		&.wide {
			grid-column: 1 / -1;
			border-right: 0;
			min-height: 42rem;
		}

		img {
			width: 100%;
			height: 100%;
			max-height: 70rem;
			object-fit: contain;
			filter: drop-shadow(0 0.8rem 1.2rem #0002);
		}

		@include mobile {
			&,
			&.wide {
				grid-column: auto;
				min-height: 25rem;
				border-right: 0;
			}
		}
	}

	.case-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-bottom: $line;

		a {
			padding: $gutter;
			text-transform: uppercase;
			font-weight: 700;

			&:hover {
				background: $yellow;
			}

			&:last-child {
				text-align: right;
				border-left: $line;
			}
		}

		@include mobile {
			grid-template-columns: 1fr;

			a:last-child {
				text-align: left;
				border-left: 0;
				border-top: $line;
			}
		}
	}
</style>
